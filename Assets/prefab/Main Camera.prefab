  m_Name: 
  m_EditorClassIdentifier: 
  uiText: {fileID: 2639581480082165004}
  fullText: "PARABENS PELA SUA BRAVURA!\n\n\"A cada minuto, centenas de vidas silvestres
    se apagam no Brasil, nao por escolha da natureza, mas pela negligencia humana.\"
    \n\n\"Tire um minuto para pensar em como esse quadro poderia ser evitado antes
    que o proximo minuto leve ainda mais vidas.\"\n\nEnquanto aqui voce controla
    a fuga, no mundo real, as queimadas matam 17.000.000 de animais anualmente e
    destroem seus lares."
  typingSpeed: 0.06
  pressEnterObject: {fileID: 833892149225095481}
  Pontuacao: {fileID: 4282726704131979048}
  Premio: {fileID: 7175580118236792060}
  blinkInterval: 0.6
