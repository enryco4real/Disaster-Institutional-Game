--- !u!1001 &1313814166
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 179457272992817539, guid: 7e9052ce6ffee5f4a8cc4b3000b65b4c, type: 3}
      propertyPath: fullText
      value: "PARABENS PELA SUA RESISTENCIA!\n\nEm meio ao concreto e fumaca, os
        cantos dos passaros se tornam cada vez mais raros abafados pela polui\xE7ao
        que nos mesmos criamos.\n\nO mundo urbano esta calando a natureza. E cada
        pequena atitude sua pode ajudar a devolver o som dos passaros.\n\nA poluicao
        sonora, do ar e do lixo urbano mata lentamente aquilo que ainda resta de
        natureza nas cidades. Ainda da tempo de mudar o final dessa historia.\n\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1954689316889915090, guid: 7e9052ce6ffee5f4a8cc4b3000b65b4c, type: 3}
      propertyPath: m_SizeDelta.x
